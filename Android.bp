package {
    default_applicable_licenses: ["android_external_lvgl_license"],
}

license {
    name: "android_external_lvgl_license",
    visibility: ["//visibility:public"],
    license_kinds: [
        "SPDX-license-identifier-MIT",
    ],
    license_text: [
        "LICENCE.txt",
    ],
}

cc_library_static {
    name: "liblvgl_twrp",
    defaults: ["twrp_defaults"],
    cflags: [
        "-DLV_CONF_INCLUDE_SIMPLE",
        "-DLV_LVGL_H_INCLUDE_SIMPLE",
        "-Wno-error",
        "-Wno-unused-parameter",
        "-Wno-unused-function",
    ],
    local_include_dirs: ["."],
    export_include_dirs: ["."],
    include_dirs: [
        "bootable/recovery/gui2",
    ],
    srcs: [
        "src/lv_init.c",
        "src/core/*.c",
        "src/display/*.c",
        "src/draw/*.c",
        "src/draw/convert/lv_draw_buf_convert.c",
        "src/draw/sw/*.c",
        "src/draw/sw/blend/*.c",
        "src/draw/sw/blend/neon/*.c",
        "src/draw/convert/neon/*.c",
        "src/image/lv_image_decoder.c",
        "src/image/lv_bin_decoder.c",
        "src/image/svg/*.c",
        "src/fs/lv_fs.c",
        "src/fs/lv_fs_posix.c",
        "src/libs/thorvg/*.cpp",
        "src/font/tiny_ttf/lv_tiny_ttf.c",
        "src/font/lv_font.c",
        "src/font/lv_font_montserrat_16.c",
        "src/font/lv_font_montserrat_24.c",
        "src/font/lv_font_montserrat_48.c",
        "src/font/fmt_txt/lv_font_fmt_txt.c",
        "src/indev/lv_indev.c",
        "src/indev/lv_indev_gesture.c",
        "src/indev/lv_indev_scroll.c",
        "src/layouts/*.c",
        "src/layouts/flex/*.c",
        "src/layouts/grid/*.c",
        "src/misc/*.c",
        "src/logging/*.c",
        "src/debugging/profiler/*.c",
        "src/misc/cache/*.c",
        "src/misc/cache/class/*.c",
        "src/misc/cache/instance/*.c",
        "src/osal/lv_os.c",
        "src/osal/lv_os_none.c",
        "src/stdlib/lv_mem.c",
        "src/stdlib/clib/*.c",
        "src/themes/*.c",
        "src/themes/default/*.c",
        "src/tick/*.c",
        "src/widgets/bar/*.c",
        "src/widgets/button/*.c",
        "src/widgets/buttonmatrix/*.c",
        "src/widgets/arc/*.c",
        "src/widgets/calendar/*.c",
        "src/widgets/chart/*.c",
        "src/widgets/checkbox/*.c",
        "src/widgets/dropdown/*.c",
        "src/widgets/image/*.c",
        "src/widgets/keyboard/*.c",
        "src/widgets/ime/*.c",
        "src/widgets/label/*.c",
        "src/widgets/line/*.c",
        "src/widgets/list/*.c",
        "src/widgets/scale/*.c",
        "src/widgets/slider/*.c",
        "src/widgets/switch/*.c",
        "src/widgets/tabview/*.c",
        "src/widgets/textarea/*.c",
    ],
}
